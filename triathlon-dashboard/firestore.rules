rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /trainingPlans/{planId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.athleteId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.athleteId == request.auth.uid);
      allow create: if isSignedIn() &&
        (isAdmin() || request.resource.data.athleteId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.athleteId == request.auth.uid);
    }
  }
}
